// Shared C++ definitions. CONFIG_BEGIN opens a section namespace; the emitter
// also uses the scope and comment columns to write the user-facing INI.
CONFIG_BEGIN(Input)
CONFIG_SECTION(Input, "")
CONFIG_SETTING(All, Input, KeyboardReadingMode, int, 0, "Keyboard reads: 0 = asynchronous, 1 = buffered. Mode 2 uses raw input where supported.")
CONFIG_SETTING(Scanners | Frontend, Input, AllowTwoPlayerKB, bool, false, "Assign a second physical keyboard to player 2. Requires raw input mode.")
CONFIG_SETTING(All, Input, XInputOmniMode, bool, false, "Merge input from all four XInput ports into the player 1 and 2 inputs.")
CONFIG_SETTING(Later, Input, PassConnStatus, bool, true, "Report controller disconnection to the game so it can pause.")
CONFIG_SETTING(Later, Input, MouseLook, bool, true, "Use mouse look in the debug world camera.")
CONFIG_SETTING(Later, Input, MouseLookSensitivity, float, 1.0f, "Debug camera mouse sensitivity multiplier.")
CONFIG_SETTING(UG2 | Frontend, Input, ConfineMouse, bool, false, "Keep the pointer within the game window while it has focus.")
CONFIG_SETTING(Frontend, Input, UseWin32Cursor, bool, true, "Render the menu pointer with the Windows cursor.")
CONFIG_SETTING(Frontend, Input, UseCustomCursor, bool, true, "Use scripts/nfs_cursor.cur for the Windows cursor.")
CONFIG_SETTING(Frontend, Input, EnableMouseHiding, bool, true, "Hide an idle menu pointer after five seconds.")

CONFIG_END()
CONFIG_BEGIN(Deadzone)
CONFIG_SECTION(Deadzone, "Stick deadzones are fractions of full travel: 0.08 = 8%. Values range from 0 to 1.")
CONFIG_SETTING(All, Deadzone, PercentLS, float, 0.08f, "Player 1 left stick.")
CONFIG_SETTING(All, Deadzone, PercentRS, float, PercentLS, "Player 1 right stick.")
CONFIG_SETTING(All, Deadzone, PercentLS_P2, float, PercentLS, "Player 2 left stick.")
CONFIG_SETTING(All, Deadzone, PercentRS_P2, float, PercentLS, "Player 2 right stick.")
CONFIG_SETTING(All, Deadzone, Percent_Shifting, float, 0.75f, "Analog activation threshold for digital shift bindings.")
CONFIG_SETTING(All, Deadzone, Percent_AnalogStickDigital, float, 0.50f, "Stick activation threshold for digital actions and menu navigation.")
CONFIG_SETTING(All, Deadzone, Percent_AnalogTriggerDigital, float, 0.12f, "Trigger activation threshold for digital actions.")

CONFIG_END()
CONFIG_BEGIN(Icons)
CONFIG_SECTION(Icons, "")
CONFIG_SETTING(All & ~UG2, Icons, FirstControlDevice, int, 0, "Initial input device: 0 = keyboard, 1 = controller.")
CONFIG_SETTING(UG | Frontend, Icons, ControllerIconMode, int, 0, IsScanner ? "0 = Xbox, 1 = PlayStation 4. Disable Widescreen Fix's icon replacement when using dynamic controller icons." : (Target == MW ? "0 = Xbox One, 1 = PS4, 2 = Xbox 360, 3 = PS3, 4 = Switch. Mode 5 uses the MW Xbox 360 icons." : "0 = Xbox One, 1 = PS4, 2 = Xbox 360, 3 = PS3, 4 = Switch."))
CONFIG_SETTING(Frontend, Icons, UseDynamicFEngSwitching, bool, HasFrontend, "Switch menu icons when the active input device changes.")
CONFIG_SETTING(Frontend, Icons, EnableSplashTakeover, bool, true, "Show the controller's continue prompt on the splash screen.")
CONFIG_SETTING(Frontend, Icons, ButtonTexFilename, const char*, "GLOBAL\\XtendedInputButtons.tpk", "Controller icon texture pack relative to the game directory.")

CONFIG_END()
CONFIG_BEGIN(Rumble)
CONFIG_SECTION(Rumble, Target == UG ? "UG1 also requires the in-game Vibration option to be enabled." : (Target == PS ? "ProStreet feedback is experimental; console curves and controller validation are pending." : ""))
CONFIG_SETTING(Feedback, Rumble, Enabled, bool, true, "Master switch for feedback hooks and controller output.")
CONFIG_SETTING(Feedback, Rumble, Intensity, float, 1.0f, "Overall strength: 0 = silent, 1 = normal, 2 = double, clamped at the controller limit.")
CONFIG_SETTING(Feedback, Rumble, LeftMotorScale, float, 1.0f, "Heavy motor strength multiplier, 0 to 2.")
CONFIG_SETTING(Feedback, Rumble, RightMotorScale, float, 1.0f, "Light motor strength multiplier, 0 to 2.")
CONFIG_SETTING(Feedback, Rumble, SwapMotors, bool, false, "Swap the two body motors.")
CONFIG_SETTING(Frontend, Rumble, Impacts, float, 1.0f, "Collisions, scrapes and damaged tyres. Strength multiplier, 0 to 2.")
CONFIG_SETTING(Frontend, Rumble, Surface, float, 1.0f, "Road texture, bumps and landings. Strength multiplier, 0 to 2.")
CONFIG_SETTING(Frontend, Rumble, Tyres, float, 1.0f, "Wheelspin, lockup and sliding. Strength multiplier, 0 to 2.")
CONFIG_SETTING(Frontend, Rumble, Car, float, 1.0f, "NOS, shifting and engine effects. Strength multiplier, 0 to 2.")
CONFIG_SETTING(Frontend, Rumble, GearShift, bool, true, "Enable the game's gear shift effect.")
CONFIG_SETTING(Triggers, Rumble, ImpulseTriggers, int, 0, "Optional Xbox One/Series trigger motors: 0 = off, 1 = broadcast to WGI pads, 2 = automatic single-pad detection.")
CONFIG_SETTING(Triggers, Rumble, TriggerIntensity, float, 1.0f, "Impulse trigger strength multiplier, 0 to 2.")
CONFIG_SETTING(Triggers, Rumble, TriggerPedalScaling, bool, true, "Scale trigger effects with the brake and throttle inputs.")
CONFIG_SETTING(Feedback, Rumble, Telemetry, bool, false, "Write diagnostic feedback data to a log beside the plugin.")

CONFIG_END()
